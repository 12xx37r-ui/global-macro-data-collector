+def _pbc_cn_archive_candidates(
+    session: requests.Session,
+    headers: dict[str, str],
+    target_months: set[str] | None = None,
+) -> list[dict[str, str]]:
+    """Discover Financial Statistics Reports from the official Chinese archive.
+
+    The English index exposes only a relatively small recent window.  The
+    Chinese 数据解读 archive is paginated and retains the exact monthly/quarterly
+    Financial Statistics Report links needed for historical CN M2 bootstrap.
+    Fetch only the first three archive pages and stop as soon as all requested
+    months are discovered.  This is bootstrap-only and introduces no provider.
+    """
+    wanted = set(target_months or [])
+    found: dict[str, dict[str, str]] = {}
+    urls = [PBC_REPORTS_CN, PBC_REPORTS_CN_PAGE.format(page=2), PBC_REPORTS_CN_PAGE.format(page=3)]
+    for u in urls:
+        if wanted and wanted.issubset(found):
+            break
+        try:
+            r = _get_retry(session, u, headers=headers, attempts=1, timeout=(5, 10))
+            for c in _pbc_listing_candidates(r.text, u):
+                mk = c.get("month")
+                if not mk:
+                    continue
+                if wanted and mk not in wanted:
+                    continue
+                found.setdefault(mk, c)
+        except Exception:
+            continue
+    return [found[k] for k in sorted(found, reverse=True)]
